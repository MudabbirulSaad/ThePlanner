{
  "name": "@mudabbirulsaad/theplanner",
  "version": "0.1.1",
  "description": "CLI-first planning graph tool for repository-native engineering plans.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "license": "MIT",
  "author": "Mudabbirul Saad",
  "homepage": "https://github.com/MudabbirulSaad/ThePlanner#readme",
  "bugs": {
    "url": "https://github.com/MudabbirulSaad/ThePlanner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MudabbirulSaad/ThePlanner.git"
  },
  "keywords": [
    "planning",
    "cli",
    "planning-graph",
    "ai-engineering",
    "work-items",
    "agents"
  ],
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "docs/adr",
    "docs/demo.md",
    "docs/production-hardening-audit.md"
  ],
  "bin": {
    "theplanner": "dist/src/adapters/cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run build && npm test && npm run lint",
    "validate:graph": "node dist/src/adapters/cli/index.js validate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
