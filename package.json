{
  "name": "ai-engineering-planner",
  "version": "0.1.0",
  "description": "CLI-first AI Engineering Planner for canonical Planning Graph artifacts.",
  "type": "module",
  "bin": {
    "planner": "dist/src/adapters/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run build && npm test && npm run lint",
    "validate:graph": "node dist/src/adapters/cli/index.js validate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
